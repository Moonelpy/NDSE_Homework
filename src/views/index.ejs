<%- include('./port/layout-start', {books: books, title: title}) %>

<div class="jumbotron jumbotron-fluid">
    <div class="container">
        <h1 class="display-4"><%= title %></h1>
    </div>
</div>
<% if (!user) { %>
    <p>Главная</p> 
    <p>Пожалуйста, <a href="/mod/user/login"> авторизуйтесь </a></p>
    <p>Или пройдите <a href="/mod/user/signup"> регистрацию </a></p>
<% } else { %>
    <p>Привет, <%= user.username %>. </p>
    <p>Перейти в <a href="/mod/user/me">профиль</a>.</p>
    <%- include('./books/library') %>
<% } %>

<%- include('./port/layout-end') %>