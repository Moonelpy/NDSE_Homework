<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Книга</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/css/bootstrap.min.css"
        integrity="sha384-TX8t27EcRE3e/ihU7zmQxVncDAy5uIKz4rEkgIXeMed4M0jlfIDPvg6uqKI2xXr2" crossorigin="anonymous">
    <script src="/socket.io/socket.io.js"></script>
</head>
<body>
    <%- include('../port/layout-start', { books: books }) %>
    <%- include('../port/menu') %>

    <h1><%= books.title %></h1>

    <div class="container">
        <div class="row">
            <div class="col-sm-8">
                <div class="card">
                    <div class="card-body">
                        <p class="card-text">Кол-во просмотров страницы: <%= count %></p>
                        <p class="card-text">Жанр: <%= books.description %></p>
                        <p class="card-text">Автор: <%= books.authors %></p>
                        <p class="card-text">В избранном: <%= books.favorite %></p>
                        <p class="card-text">Обложка: <%= books.fileCover %></p>
                        <p class="card-text">Имя файла: <%= books.fileName %></p>
                        <div class="text-right">
                            <a class="btn btn-sm btn-primary" href="/mod/books/update/<%= books.id %>">
                                <i class="fa fa-pencil" aria-hidden="true"></i>
                            </a>
                            <form action="/mod/books/delete/<%= books.id %>" method="POST" class="d-inline">
                                <button class="btn btn-sm btn-danger">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <h2>Комментарии</h2>
        <div id="comments" class="row mb-3">
            <div class="col-8">
                <div class="list-group">
                    <!-- Здесь будут отображаться сообщения -->
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-4">
                <div class="form-group">
                    <label for="username">Имя пользователя</label>
                    <input placeholder="Имя пользователя" type="text" id="username" class="form-control">
                </div>
                <div class="form-group">
                    <label for="text">Сообщение</label>
                    <textarea placeholder="Сообщение" class="form-control" id="text"></textarea>
                </div>
                <button type="button" id="send-room" class="btn btn-primary">Отправить в канал</button>
            </div>
        </div>
    </div>

    <script>
        // Подключение к WebSocket серверу и отправка/получение сообщений
        const roomName = location.pathname.split('/').pop();
        const socket = io.connect('/', { query: `roomName=${roomName}` });

        const commentsList = document.getElementById('comments');
        const inputUsername = document.getElementById('username');
        const inputText = document.getElementById('text');
        const sendRoom = document.getElementById('send-room');

        const getTmp = (msg) => {
            // Функция для формирования HTML шаблона комментария
            return `
                <div class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between">
                        <small>${msg.username}</small>
                        <small class="text-muted">${msg.type}</small>
                    </div>
                    <p class="mb-1">${msg.text}</p>
                </div>
            `;
        };
        
        // Обработчик нажатия кнопки
        sendRoom.addEventListener('click', () => {
            socket.emit('message-to-room', {
                username: inputUsername.value,
                text: inputText.value,
            });
            inputText.value = '';
        });
       
        // Обработчик получения сообщения от WebSocketа
        socket.on('message-to-room', (msg) => {
            const div = getTmp(msg);
            commentsList.querySelector('.list-group').insertAdjacentHTML('beforeend', div);
        });

    </script>
    <%- include('../port/layout-end') %>

</body>
</html>
